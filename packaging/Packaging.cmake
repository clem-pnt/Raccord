# Desktop integration
install(FILES ${CMAKE_SOURCE_DIR}/packaging/linux/raccord.desktop DESTINATION share/applications)
install(FILES ${CMAKE_SOURCE_DIR}/packaging/linux/raccord.svg DESTINATION share/icons/hicolor/scalable/apps)
install(FILES ${CMAKE_SOURCE_DIR}/packaging/linux/raccord-mime.xml DESTINATION share/mime/packages RENAME raccord.xml)
install(FILES ${CMAKE_SOURCE_DIR}/packaging/linux/io.github.raccord.Raccord.metainfo.xml DESTINATION share/metainfo)

set(CPACK_PACKAGE_NAME "raccord")
set(CPACK_PACKAGE_VENDOR "Raccord")
set(CPACK_PACKAGE_CONTACT "Raccord <noreply@raccord.invalid>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Professional non-linear video editor for Linux")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_GENERATOR "DEB;TGZ")
set(CPACK_DEBIAN_PACKAGE_SECTION "video")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "python3-venv, qt6-translations-l10n")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
include(CPack)
